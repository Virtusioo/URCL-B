
main() {
    auto tape, p, prog, pc, c, loop;
    tape = malloc(1000);
    p = tape;
    /* 20 digits of PI (EXTREMELY SLOW!! 1BILLION INSTRUCTIONS) */
    prog = ">++++++++++++++++++++
            [<+>>>>>>>>++++++++++<<<<<<<-]>+++++[<+++++++++>-]+>>>>>>+[<<+++[>>[-<]<[>]<-]>>
            [>+>]<[<]>]>[[->>>>+<<<<]>>>+++>-]<[<<<<]<<<<<<<<+[->>>>>>>>>>>>[<+[->>>>+<<<<]>
            >>>>]<<<<[>>>>>[<<<<+>>>>-]<<<<<-[<<++++++++++>>-]>>>[<<[<+<<+>>>-]<[>+<-]<++<<+
            >>>>>>-]<<[-]<<-<[->>+<-[>>>]>[[<+>-]>+>>]<<<<<]>[-]>+<<<-[>>+<<-]<]<<<<+>>>>>>>
            >[-]>[<<<+>>>-]<<++++++++++<[->>+<-[>>>]>[[<+>-]>+>>]<<<<<]>[-]>+>[<<+<+>>>-]<<<
            <+<+>>[-[-[-[-[-[-[-[-[-<->[-<+<->>]]]]]]]]]]<[+++++[<<<++++++++<++++++++>>>>-]<
            <<<+<->>>>[>+<<<+++++++++<->>>-]<<<<<[>>+<<-]+<[->-<]>[>>.<<<<[+.[-]]>>-]>[>>.<<
            -]>[-]>[-]>>>[>>[<<<<<<<<+>>>>>>>>-]<<-]]>>[-]<<<[-]<<<<<<<<]++++++++++.";
    pc = prog;

    while (*pc) {
        c = *pc;
        if (c == '>') {
            p = p + 1;
        } else if (c == '<') {
            p = p - 1;
        } else if (c == '+') {
            *p = *p + 1;
        } else if (c == '-') {
            *p = *p - 1;
        } else if (c == '.') {
            putchar(*p);
        } else if (c == ',') {
            *p = getchar();
        } else if (c == '[') {
            if (!*p) {
                loop = 1;
                while (loop) {
                    pc = pc + 1;
                    if (*pc == '[') loop = loop + 1;
                    if (*pc == ']') loop = loop - 1;
                }
            }
        } else if (c == ']') {
            if (*p) {
                loop = 1;
                while (loop) {
                    pc = pc - 1;
                    if (*pc == ']') loop = loop + 1;
                    if (*pc == '[') loop = loop - 1;
                }
            }
        }
        pc = pc + 1;
    }
}
